# Nonblocking HTTP/TLS uses SDK async connection support with zero-timeout polls.
# Keep the SDK checkout immutable and fail on an unreviewed polling implementation.
idf_component_get_property(transport_lib tcp_transport COMPONENT_LIB)
idf_component_get_property(transport_dir tcp_transport COMPONENT_DIR)
idf_component_get_property(websocket_lib espressif__esp_websocket_client COMPONENT_LIB)
idf_component_get_property(websocket_dir espressif__esp_websocket_client COMPONENT_DIR)
set(polling_dir "${CMAKE_BINARY_DIR}/http_transport_polling")
set(polling_tool "${CMAKE_SOURCE_DIR}/tools/prepare_http_transport_polling.py")
execute_process(
    COMMAND "${Python3_EXECUTABLE}" "${polling_tool}" --idf-dir "$ENV{IDF_PATH}" --output "${polling_dir}" --websocket-source "${websocket_dir}/esp_websocket_client.c"
    RESULT_VARIABLE polling_result
    ERROR_VARIABLE polling_error
)
if(NOT polling_result EQUAL 0)
    message(FATAL_ERROR "HTTP nonblocking transport unavailable: ${polling_error}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${polling_tool}" "${transport_dir}/transport_ssl.c"
    "${transport_dir}/transport_ws.c" "${websocket_dir}/esp_websocket_client.c")
get_target_property(transport_sources ${transport_lib} SOURCES)
set(updated_sources "")
set(found_transport "")
foreach(source IN LISTS transport_sources)
    get_filename_component(source_name "${source}" NAME)
    if(source_name STREQUAL "transport_ssl.c" OR source_name STREQUAL "transport_ws.c")
        list(APPEND updated_sources "${polling_dir}/${source_name}")
        list(APPEND found_transport "${source_name}")
    else()
        list(APPEND updated_sources "${source}")
    endif()
endforeach()
list(SORT found_transport)
if(NOT found_transport STREQUAL "transport_ssl.c;transport_ws.c")
    message(FATAL_ERROR "Cannot replace SDK transport sources; SDK sources changed")
endif()
set_property(TARGET ${transport_lib} PROPERTY SOURCES ${updated_sources})
target_include_directories(${transport_lib} PRIVATE "${transport_dir}")
# Bound complete HTTP response headers; binary bodies use each owner's own cap.
idf_component_get_property(parser_lib http_parser COMPONENT_LIB)
target_compile_definitions(${parser_lib} PRIVATE HTTP_MAX_HEADER_SIZE=16384)

# Feed confirmed FIN to the existing HTTP parser. This preserves valid EOF
# framing while the same parser continues rejecting short CL/chunked bodies.
idf_component_get_property(client_lib esp_http_client COMPONENT_LIB)
idf_component_get_property(client_dir esp_http_client COMPONENT_DIR)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${client_dir}/esp_http_client.c")
get_target_property(client_sources ${client_lib} SOURCES)
set(updated_sources "")
set(found FALSE)
foreach(source IN LISTS client_sources)
    if(source STREQUAL "${client_dir}/esp_http_client.c" OR source STREQUAL "esp_http_client.c")
        list(APPEND updated_sources "${polling_dir}/esp_http_client.c")
        set(found TRUE)
    else()
        list(APPEND updated_sources "${source}")
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "Cannot replace SDK esp_http_client.c; SDK sources changed")
endif()
set_property(TARGET ${client_lib} PROPERTY SOURCES ${updated_sources})
target_include_directories(${client_lib} PRIVATE "${client_dir}")

# Managed dependency stays immutable, just like the shared ESP-IDF checkout.
get_target_property(websocket_sources ${websocket_lib} SOURCES)
set(updated_sources "")
set(found FALSE)
foreach(source IN LISTS websocket_sources)
    if(source STREQUAL "${websocket_dir}/esp_websocket_client.c" OR source STREQUAL "esp_websocket_client.c")
        list(APPEND updated_sources "${polling_dir}/esp_websocket_client.c")
        set(found TRUE)
    else()
        list(APPEND updated_sources "${source}")
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "Cannot replace managed WebSocket client; dependency sources changed")
endif()
set_property(TARGET ${websocket_lib} PROPERTY SOURCES ${updated_sources})
target_include_directories(${websocket_lib} PRIVATE "${websocket_dir}")
